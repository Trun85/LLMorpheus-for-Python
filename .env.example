# LLMorpheus for Python - local settings.
#
#   cp .env.example .env      then fill in your API key.
#
# .env is gitignored: never commit it, and never put keys in any other file.
# Per-project settings (paths, test command, excludes) belong in subjects/<name>.conf.
#
# Precedence, highest first:
#   command-line flags > shell environment > subjects/<name>.conf > .env > built-in defaults
# See the effective result, with keys masked:
#   llmorpheus config --subject <name>
#
# Format: KEY=VALUE, one per line. "#" starts a comment. Quote values that
# contain " #". Empty values count as unset.

# --- API keys: only the provider you use needs one --------------------------
DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=

# --- LLM ----------------------------------------------------------------------
LLMORPHEUS_PROVIDER=deepseek
# Leave the model unset to use the provider's default (deepseek -> deepseek-flash).
# A model set here applies to whichever provider is active.
# LLMORPHEUS_MODEL=deepseek-flash
LLMORPHEUS_TEMPERATURE=0.0
# Thinking mode ignores the temperature and bills reasoning tokens; see README.
LLMORPHEUS_THINKING=false
# LLMORPHEUS_MAX_TOKENS=250
LLMORPHEUS_CONCURRENCY=4
LLMORPHEUS_ATTEMPTS=3
# LLMORPHEUS_RATE_LIMIT_MS=0
# LLMORPHEUS_REQUEST_TIMEOUT=120
# LLMORPHEUS_BASE_URL=
# LLMORPHEUS_API_KEY_ENV=

# --- Prompting ----------------------------------------------------------------
# LLMORPHEUS_TEMPLATE=template-full
# LLMORPHEUS_SYSTEM_TEMPLATE=system-mutation-testing-expert
# LLMORPHEUS_KINDS=default

# --- Test execution defaults (usually set per project instead) ----------------
# LLMORPHEUS_JOBS=1
# LLMORPHEUS_TEST_TIMEOUT=

# --- Where subject files live (default: subjects/ next to this file) ---------
# LLMORPHEUS_SUBJECTS_DIR=subjects
